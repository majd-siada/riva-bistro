{
  "name": "@riva-bistro/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Generated OpenAPI TypeScript types for Riva Bistro",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o src/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.0"
  }
}
