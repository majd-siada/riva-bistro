{
  "color": {
    "primitive": {
      "charcoalDeep": "#0F1418",
      "charcoal": "#161616",
      "black": "#0a0a0a",
      "ivory": "#F4F0E6",
      "mist": "#D9D2C3",
      "gold": "#BFA06A",
      "goldMuted": "#8f774f",
      "teal": "#5E8B8B",
      "tealMuted": "#4A7373",
      "error": "#C45C5C",
      "success": "#5E8B6E"
    },
    "semantic": {
      "surfaceDefault": "{color.primitive.black}",
      "surfaceElevated": "{color.primitive.charcoal}",
      "surfaceSubtle": "{color.primitive.charcoalDeep}",
      "textPrimary": "{color.primitive.ivory}",
      "textMuted": "{color.primitive.mist}",
      "textAccent": "{color.primitive.gold}",
      "borderSubtle": "rgba(244, 240, 230, 0.1)",
      "borderAccent": "{color.primitive.gold}",
      "accentTeal": "{color.primitive.teal}",
      "accentGold": "{color.primitive.gold}",
      "statusError": "{color.primitive.error}",
      "statusSuccess": "{color.primitive.success}"
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px"
  },
  "motion": {
    "durationFast": "150ms",
    "durationNormal": "250ms",
    "durationSlow": "400ms",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "breakpoint": {
    "mobile": "375px",
    "tablet": "768px",
    "desktop": "1280px",
    "wide": "1440px"
  },
  "typography": {
    "fontDisplay": "Cormorant Garamond, ui-serif, Georgia, serif",
    "fontSans": "Source Sans 3, ui-sans-serif, system-ui, sans-serif",
    "scale": {
      "h1": { "size": "64px", "lineHeight": "1.1", "weight": 500 },
      "h2": { "size": "48px", "lineHeight": "1.15", "weight": 500 },
      "h3": { "size": "32px", "lineHeight": "1.2", "weight": 500 },
      "body": { "size": "16px", "lineHeight": "1.6", "weight": 400 },
      "bodyLg": { "size": "18px", "lineHeight": "1.6", "weight": 400 },
      "label": { "size": "12px", "lineHeight": "1.4", "weight": 600, "letterSpacing": "0.2em" },
      "price": { "size": "20px", "lineHeight": "1.2", "weight": 600 }
    }
  }
}
