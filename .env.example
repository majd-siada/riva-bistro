# =============================================================================
# Riva Bistro — local development environment
# Copy to .env and adjust as needed. Never commit real secrets.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=riva_bistro
POSTGRES_USER=riva
POSTGRES_PASSWORD=riva_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
DATABASE_URL=postgres://riva:riva_dev_password@postgres:5432/riva_bistro

# --- Next.js ---
# Production (rivabistro.se on Hostinger):
# NEXT_PUBLIC_API_URL=https://api.rivabistro.se
# NEXT_PUBLIC_SITE_URL=https://rivabistro.se
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
NODE_ENV=development

# --- Media / object storage (local filesystem for Phase 1) ---
MEDIA_STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
# Future S3/R2 (unused in Phase 1):
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=

# --- Email ---
# Development uses Django's console backend by default (emails are printed,
# which is a real send from Django's side — nothing is faked). For production,
# set EMAIL_BACKEND to SMTP and provide credentials via secrets.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Riva Bistro <no-reply@rivabistro.se>
# Destination inbox for contact + private-event inquiries. Leave blank to keep
# inquiries disabled (the API returns an error rather than faking a send).
RESTAURANT_NOTIFICATION_EMAIL=

# --- Admin user seed (python manage.py seed_admin) ---
# Always set a strong DJANGO_ADMIN_PASSWORD in production.
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@rivabistro.se
DJANGO_ADMIN_PASSWORD=change-me-in-production

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Telegram (Phase 5; staff booking alerts) ---
# Create via https://t.me/BotFather — do not commit real tokens.
TELEGRAM_BOT_TOKEN=
# Chat/group id where alerts are sent (message the bot, then read getUpdates).
TELEGRAM_CHAT_ID=
