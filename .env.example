# =============================================================================
# Riva Bistro — local development environment
# Copy to .env and adjust as needed. Never commit real secrets.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=riva_bistro
POSTGRES_USER=riva
POSTGRES_PASSWORD=riva_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgres://riva:riva_dev_password@postgres:5432/riva_bistro

# --- Next.js ---
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
NODE_ENV=development

# --- Media / object storage (local filesystem for Phase 1) ---
MEDIA_STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
# Future S3/R2 (unused in Phase 1):
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=

# --- Telegram (Phase 5; unused in Phase 1) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
