# =============================================================================
# Riva Bistro — environment template
# Copy to .env for LOCAL development. Never commit real secrets.
# Full cutover checklist: docs/deployment/production-checklist.md
# =============================================================================

# =============================================================================
# LOCAL DEVELOPMENT
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=riva_bistro
POSTGRES_USER=riva
POSTGRES_PASSWORD=riva_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Local cookies: leave COOKIE_DOMAIN unset; SameSite defaults to Lax.
DATABASE_URL=postgres://riva:riva_dev_password@postgres:5432/riva_bistro

# --- Next.js ---
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Do not set NODE_ENV — Next.js manages it (NODE_ENV=development breaks `next build`).

# --- Media (local filesystem) ---
MEDIA_STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
MEDIA_SERVE=true

# --- Email (console backend while DJANGO_DEBUG=true) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Riva Bistro <no-reply@rivabistro.se>
RESTAURANT_NOTIFICATION_EMAIL=

# --- Admin seed (python manage.py seed_admin) ---
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@rivabistro.se
DJANGO_ADMIN_PASSWORD=change-me-in-production

# --- Telegram staff alerts (@RivaB_bot) ---
# 1) Set TELEGRAM_BOT_TOKEN from BotFather (never commit the real token).
# 2) Message the bot in Telegram, then run:
#      python manage.py telegram_discover_chat
# 3) Put the printed chat id into TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Hostinger Mail API (optional staff reservation email) ---
# pip package: hostinger_mail_api. Leave blank to use Django EMAIL_* SMTP instead.
# HOSTINGER_MAIL_API_TOKEN=<bearer token from Hostinger — never commit>
# HOSTINGER_MAIL_MAILBOX_RESOURCE_ID=<mailbox resource id>
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAIL_MAILBOX_RESOURCE_ID=

# Optional error monitoring (install sentry-sdk in the API image to activate)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# =============================================================================
# PRODUCTION (Hostinger frontend + API host) — set on hosts; do not commit secrets
# See docs/deployment/production-checklist.md
# =============================================================================
#
# --- Frontend (Hostinger Node — bake at build time) ---
# NEXT_PUBLIC_SITE_URL=https://rivabistro.se
# NEXT_PUBLIC_API_URL=https://api.rivabistro.se
# INTERNAL_API_URL=https://api.rivabistro.se
#
# --- Backend (API process) ---
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<OWNER/HOSTINGER SECRET>
# DJANGO_ALLOWED_HOSTS=api.rivabistro.se
# DJANGO_CORS_ALLOWED_ORIGINS=https://rivabistro.se,https://www.rivabistro.se
# DJANGO_CSRF_TRUSTED_ORIGINS=https://rivabistro.se,https://www.rivabistro.se,https://api.rivabistro.se
# DJANGO_COOKIE_SAMESITE=None
# DJANGO_COOKIE_DOMAIN=.rivabistro.se
# DATABASE_URL=postgres://...
# MEDIA_SERVE=true
# MEDIA_ROOT=<persistent volume path>
#
# --- SMTP ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# RESTAURANT_NOTIFICATION_EMAIL=
#
# --- DNS ---
# rivabistro.se → frontend
# api.rivabistro.se → A/CNAME to HOSTINGER/API HOST VALUE REQUIRED
#
# --- After API is up ---
# python manage.py migrate --noinput
# optional: seed_admin, seed_reservations, seed_menu, seed_gallery
# Admin → capacity, then production_ready=true only when ready
# frontend/src/config/business.ts → real NAP, then verified=true
# =============================================================================
